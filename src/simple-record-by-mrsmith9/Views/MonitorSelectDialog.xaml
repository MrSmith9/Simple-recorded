<Window x:Class="SimpleRecord.Views.MonitorSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a monitor to record"
        Icon="/Assets/AppIcon.ico"
        Width="480" Height="420"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose a monitor to record" Style="{StaticResource HeadingText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" Margin="0,0,0,12">
            Use the Up and Down arrow keys to move through the list, then press Enter - or click a monitor, then click Select.
        </TextBlock>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
            <ListBox x:Name="MonitorListBox" Background="Transparent" BorderThickness="0" FontSize="16"
                     Foreground="{StaticResource TextPrimaryBrush}" Padding="8"
                     SelectionMode="Single" MouseDoubleClick="MonitorListBox_MouseDoubleClick"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="_Cancel" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="SelectButton" Content="_Select" Style="{StaticResource PrimaryButton}"
                    Click="SelectButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
